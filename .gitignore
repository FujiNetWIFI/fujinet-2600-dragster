# Build output. Every image in here embeds the whole of Dragster, so this has to
# stay out for the same reason rom/ does, quite apart from being generated.
build/

# THE CARTRIDGE ITSELF IS NOT IN THIS REPOSITORY.
#
# Dragster is Activision's, 1980, and David Crane's. This project is a patch and
# a server; it is not a place to redistribute it. Supply your own dump -- see
# rom/README.md for the file, its md5, and how the disassembly is produced.
rom/*.bin
rom/*.asm

# The C relay's binary. server/c/ itself is source and belongs in the tree.
server/c/dragster-relay

# Python
__pycache__/
*.pyc

# Editors and the usual detritus
*.swp
*~
.DS_Store
